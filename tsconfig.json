{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsxImportSource": "nativewind",
    "types": ["jest"]
  },
  "include": [
    "src",
    "lib",
    "server",
    "rag",
    "index.ts",
    "src/global.d.ts",
    "nativewind-env.d.ts",
    "custom.d.ts",
    "app.config.js",
    "jest.config.js",
    "jest.setup.js"
  ],
  "exclude": [
    "supabase/functions",
    "babel.config.js",
    "node_modules",
    "metro.config.js"
  ]
}
